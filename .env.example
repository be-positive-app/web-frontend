# Client API base (import.meta.env.VITE_API_BASE_URL)
#
# Empty: use /api/v1 on same origin (Vite dev proxy in development).
#
# Production or direct-to-API: use a full URL OR hostname only (https is added for hosts).
# Examples:
#   VITE_API_BASE_URL=https://backend-production-xxxx.up.railway.app
#   VITE_API_BASE_URL=backend-production-xxxx.up.railway.app
#
# Without https://, a bare hostname MUST be normalized in code -- otherwise the browser
# treats it as a path on localhost (e.g. http://localhost:5173/your-hostname).
#
# Local API:
#   VITE_API_BASE_URL=http://localhost:3000

VITE_API_BASE_URL=

# Dev only: Vite proxies /api to this target when VITE_API_BASE_URL is empty.

VITE_DEV_PROXY_TARGET=http://localhost:3000
